<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#070A0F">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <Space
            android:layout_width="1dp"
            android:layout_height="60dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SHAYAN"
            android:textColor="#00FF88"
            android:textStyle="bold"
            android:textSize="18sp"
            android:letterSpacing="0.25"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="PUBG LAUNCHER"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="32sp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fast • Clean • Secure"
            android:textColor="#8A93A3"
            android:textSize="15sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="38dp"
            android:orientation="vertical"
            android:padding="22dp"
            android:background="@drawable/panel_background">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GAME STATUS"
                android:textColor="#00FF88"
                android:textStyle="bold"
                android:textSize="13sp"/>

            <TextView
                android:id="@+id/txtGameStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Checking PUBG Mobile..."
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="20sp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Global Version • com.tencent.ig"
                android:textColor="#8A93A3"
                android:textSize="13sp"/>

            <Button
                android:id="@+id/btnLaunch"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="28dp"
                android:text="LAUNCH PUBG MOBILE"
                android:textColor="#07110B"
                android:textStyle="bold"
                android:textSize="16sp"
                android:backgroundTint="#00FF88"/>

            <Button
                android:id="@+id/btnOpenMenu"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="OPEN FLOATING MENU"
                android:textColor="#00FF88"
                android:textStyle="bold"
                android:textSize="15sp"
                android:backgroundTint="#202834"/>

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:text="DEVELOPED BY SHAYAN"
            android:textColor="#596273"
            android:textSize="12sp"/>

    </LinearLayout>

</ScrollView>
